{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "<serveur MOSIP>",
  "database.port": "5432",
  "database.user": "eidreporting",
  "database.password": "<mot de passe>",
  "database.dbname": "mosip_master",
  "topic.prefix": "mosip_master",
  "plugin.name": "pgoutput",
  "slot.name": "mosip_master_cdc",
  "slot.drop.on.stop": "false",
  "publication.name": "dbz_publication",
  "publication.autocreate.mode": "disabled",
  "schema.include.list": "master",
  "table.include.list": "master.location,master.registration_center,master.dynamic_field",
  "column.include.list": "master\\.location\\.(code|lang_code|name|hierarchy_level|hierarchy_level_name|parent_loc_code|is_active|is_deleted|cr_dtimes|upd_dtimes),master\\.registration_center\\.(id|lang_code|name|cntrtyp_code|location_code|zone_code|latitude|longitude|is_active|is_deleted|cr_dtimes|upd_dtimes),master\\.dynamic_field\\.(id|name|description|data_type|value_json|lang_code|is_active|is_deleted|cr_dtimes|upd_dtimes)",
  "snapshot.mode": "initial",
  "tombstones.on.delete": "false",
  "heartbeat.interval.ms": "60000",
  "heartbeat.action.query": "UPDATE debezium.heartbeat SET ts = now() WHERE id = 1",
  "transforms": "route",
  "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.route.regex": "mosip_master\\.master\\.(.*)",
  "transforms.route.replacement": "mosip.master.$1"
}
