{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "<serveur MOSIP>",
  "database.port": "5432",
  "database.user": "eidreporting",
  "database.password": "<mot de passe>",
  "database.dbname": "mosip_regprc",
  "topic.prefix": "mosip_regprc_impression",
  "plugin.name": "pgoutput",
  "slot.name": "mosip_regprc_impression_cdc",
  "slot.drop.on.stop": "false",
  "publication.name": "dbz_publication",
  "publication.autocreate.mode": "disabled",
  "schema.include.list": "regprc",
  "table.include.list": "regprc.printing_orders,regprc.printing_orders_details,regprc.printing_shipped_cards",
  "column.include.list": "regprc\\.printing_orders\\.(id|rid|request_id|prc_status|entry_date|issuing_date),regprc\\.printing_orders_details\\.(id|request_id|status_code|reason_code|sub_status_code|cr_dtimes),regprc\\.printing_shipped_cards\\.(id|request_id|entry_date|delivery_status|delivery_mode|delivery_date)",
  "snapshot.mode": "initial",
  "snapshot.fetch.size": "10000",
  "snapshot.select.statement.overrides": "regprc.printing_orders,regprc.printing_orders_details,regprc.printing_shipped_cards",
  "snapshot.select.statement.overrides.regprc.printing_orders": "SELECT id, rid, request_id, prc_status, entry_date, issuing_date FROM regprc.printing_orders",
  "snapshot.select.statement.overrides.regprc.printing_orders_details": "SELECT id, request_id, status_code, reason_code, sub_status_code, cr_dtimes FROM regprc.printing_orders_details WHERE status_code IN ('NEW-PRINT-CANCELED', 'PRINT-REQUEST-ERR')",
  "snapshot.select.statement.overrides.regprc.printing_shipped_cards": "SELECT id, request_id, entry_date, delivery_status, delivery_mode, delivery_date FROM regprc.printing_shipped_cards",
  "tombstones.on.delete": "false",
  "skipped.operations": "t",
  "heartbeat.interval.ms": "60000",
  "transforms": "route",
  "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.route.regex": "mosip_regprc_impression\\.regprc\\.(.*)",
  "transforms.route.replacement": "mosip.regprc.$1"
}
