{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "<serveur MOSIP>",
  "database.port": "5432",
  "database.user": "eidreporting",
  "database.password": "<mot de passe>",
  "database.dbname": "mosip_ida",
  "topic.prefix": "mosip_ida",
  "plugin.name": "pgoutput",
  "slot.name": "mosip_ida_cdc",
  "slot.drop.on.stop": "false",
  "publication.name": "dbz_publication",
  "publication.autocreate.mode": "disabled",
  "schema.include.list": "ida",
  "table.include.list": "ida.auth_transaction,ida.otp_transaction",
  "column.include.list": "ida\\.auth_transaction\\.(id|cr_dtimes|auth_type_code|status_code|status_comment|requested_entity_type|requested_entity_id|requested_entity_name|is_deleted),ida\\.otp_transaction\\.(id|status_code|cr_dtimes|expiry_dtimes|is_deleted)",
  "snapshot.mode": "initial",
  "snapshot.fetch.size": "10000",
  "snapshot.select.statement.overrides": "ida.auth_transaction,ida.otp_transaction",
  "snapshot.select.statement.overrides.ida.auth_transaction": "SELECT id, cr_dtimes, auth_type_code, status_code, status_comment, requested_entity_type, requested_entity_id, requested_entity_name, is_deleted FROM ida.auth_transaction",
  "snapshot.select.statement.overrides.ida.otp_transaction": "SELECT id, status_code, cr_dtimes, expiry_dtimes, is_deleted FROM ida.otp_transaction",
  "tombstones.on.delete": "false",
  "skipped.operations": "t",
  "heartbeat.interval.ms": "60000",
  "transforms": "route",
  "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.route.regex": "mosip_ida\\.ida\\.(.*)",
  "transforms.route.replacement": "mosip.ida.$1"
}
