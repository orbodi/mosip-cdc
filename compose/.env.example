# Copier en .env dans ce meme dossier (compose/), puis : chmod 600 .env
# Le fichier .env n'est jamais versionne. Mettre une valeur entre apostrophes
# si elle contient des caracteres speciaux : DBT_PASSWORD='ab$cd ef'

# BD traitement BI
TRAITEMENT_PG_HOST=172.16.44.108
DBT_PASSWORD=<mot de passe de dbt_runner>
PUBLISHER_PASSWORD=<mot de passe de publisher>
SPARK_READER_PASSWORD=<mot de passe de spark_reader>

# Tableau de bord (compose/docker-compose.dashboard.yml)
BI_OWNER_PASSWORD=<mot de passe de bi_owner>
API_READER_PASSWORD=<mot de passe de api_reader>
DASHBOARD_DIR=/data/mosip-bi-reporting
# Adresse du tableau de bord pour les utilisateurs (30/10/2026) : http://172.16.26.86:5173/enrolement
FRONT_HOTE=172.16.26.86

# Cle secrete du suivi d'un dossier : empreinte HMAC du RID (bi.suivi_dossier).
# Lue par scripts/publier-indicateurs.sh et par l'API (compose/docker-compose.dashboard.yml).
# A generer une fois : openssl rand -hex 32. La changer oblige a relancer scripts/charger-suivi.sh.
SUIVI_HMAC_CLE=<64 caracteres hexadecimaux>

# Facultatif : surveillance du slot de replication sur MOSIP (scripts/check-health.sh)
MOSIP_PG_HOST=<adresse du serveur MOSIP>
MOSIP_PG_PASSWORD=<mot de passe de eidreporting>

# API de pre-inscription MOSIP (job Spark d'enrichissement)
API_URL=https://apis.apps.ocp-prod-dmz.eid.local
API_APP_ID=regproc
API_CLIENT_ID=<clientId>
API_SECRET_KEY='<secretKey>'
# Verification du certificat de l'API : false par defaut ; true une fois compose/certs/ca-eid.crt en place
API_TLS_VERIFY=false

# ID Repository de MOSIP (enrichissement des inscriptions qui ont un NIU, appelees par leur RID ; lot 6).
# Vides : memes passerelle et identifiants que l'API de pre-inscription ci-dessus.
IDREPO_URL=
IDREPO_APP_ID=<appId>
IDREPO_CLIENT_ID=<clientId>
IDREPO_SECRET_KEY='<secretKey>'
